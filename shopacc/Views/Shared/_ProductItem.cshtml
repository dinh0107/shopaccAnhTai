@model shopacc.Models.Product

<a href="@Url.Action("ProductDetail", new {url = Model.Url})" class="product-item-card bg-white rounded-xl shadow-md overflow-hidden border border-slate-200 block transition hover:shadow-xl">
    @if (Model.ListImage != null)
    {
        <img src="@Path.Combine("/images/product/", Model.ListImage.Split(',')[0])"
             alt="@Model.Name"
             class="w-full h-56 object-cover">
    }

    <div class="px-4 pt-4 pb-3 text-center">
        <div class="flex justify-between items-center">
            <div class="flex justify-center mb-2">
                @if (Model.ChoThue)
                {
                    <span class="bg-red-500 text-white text-xs px-2.5 py-1 rounded-full flex items-center gap-1 font-semibold">
                        <span class="w-1.5 h-1.5 bg-white rounded-full"></span>
                        Đã bán
                    </span>
                }
                else
                {
                    <span class="bg-emerald-600 text-white text-xs px-2.5 py-1 rounded-full flex items-center gap-1 font-semibold">
                        <span class="w-1.5 h-1.5 bg-white rounded-full"></span>
                        Còn Hàng
                    </span>
                }
            </div>

            <p class="product-code text-base font-semibold text-right text-slate-800">
                Mã Acc:
                <span class="font-bold text-slate-900 block text-lg">@Model.Name</span>
            </p>
        </div>

        <div class="border-t border-dashed border-slate-200 w-full my-2"></div>

        <p class="product-price-label text-base font-bold text-slate-800 pt-1">
            Giá:
            <span class="product-price-value text-red-600 font-extrabold text-xl">
                @Html.DisplayFor(a => Model.Price)
                @if (Model.NgoaiTe != null)
                {
                    @:(@Model.NgoaiTe)
                }
            </span>
        </p>
    </div>
</a>
