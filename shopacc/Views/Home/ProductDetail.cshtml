@model shopacc.ViewModel.ProductDetail
@using shopacc.Models
@using Helpers
@using System.Globalization
@{
    var config = (ConfigSite)HttpContext.Current.Application["ConfigSite"];
    ViewBag.Title = Model.Product.TitleMeta ?? Model.Product.Name;
    ViewBag.Canonical = Request.Url?.GetLeftPart(UriPartial.Authority) + Url.Action("ProductDetail", new { url = Model.Product.Url });
    if (Model.Product.ListImage != null)
    {
        ViewBag.ImageShare = Request.Url?.GetLeftPart(UriPartial.Authority) + Path.Combine("/images/product/", Model.Product.ListImage.Split(',')[0]);
    }
    var discount = Model.Product.Price * 0.3m;
    var culture = new CultureInfo("vi-VN");


    var cdn = "<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@fancyapps/ui/dist/fancybox.css\" />\r\n<script src=\"https://cdn.jsdelivr.net/npm/@fancyapps/ui/dist/fancybox.umd.js\"></script>";
}
<div class="breadcrumb-container px-4 sm:px-8 lg:px-20 py-3.5 mb-2">
    <nav class="flex items-center space-x-2 text-sm" aria-label="Breadcrumb">
        <a href="/" class="text-slate-600 hover:text-orange-500 font-medium">Trang chủ</a>
        <span class="text-slate-400">/</span>
        <a href="/" class="text-slate-600 hover:text-orange-500 font-medium">Tài khoản</a>
        <span class="text-slate-400">/</span>
        <strong class="text-slate-900 font-bold">#@Model.Product.Name</strong>
    </nav>
</div>

<div class="container mx-auto p-4">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2">
            <div class="bg-white rounded-lg shadow-lg p-4">
                <div class="slider-container mb-4 rounded-lg overflow-hidden">
                    @if (Model.Product.ListImage != null)
                    {
                        var arr = Model.Product.ListImage.Split(',');
                        <div class="slider-wrapper slider-for" id="slider-for">
                            @foreach (var item in arr)
                            {
                                var imgPath = Path.Combine("/images/product/", item);

                                <div class="slider-item-img">
                                    <a href="@imgPath"
                                       data-fancybox="product-gallery"
                                       data-caption="@Model.Product.Name">
                                        <img src="@imgPath"
                                             alt="@Model.Product.Name"
                                             class="w-full h-auto cursor-pointer">
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="slider-nav">
                    @if (Model.Product.ListImage != null)
                    {
                        var arr = Model.Product.ListImage.Split(',');
                        foreach (var item in arr)
                        {
                            <img src="@Path.Combine("/images/product/", item)" alt="@Model.Product.Name" class="thumbnail active rounded">
                        }
                    }
                </div>
            </div>

            <div class="product-card-container bg-white/95 rounded-2xl shadow-lg p-6 mt-6 border border-slate-100">
                <div class="text-xl font-extrabold text-slate-900 mb-4 pb-2 border-b border-slate-100">Mô tả chi tiết</div>
                <div class="text-slate-700 body-html text-base leading-relaxed">
                    @Html.Raw(Model.Product.Body)
                </div>
            </div>
        </div>

        <div class="lg:col-span-1">
            <div class="product-card-container bg-white/95 rounded-2xl shadow-lg p-5 sm:p-6 mb-6 border border-slate-100">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2 mb-4 sm:mb-6">
                    <span class="text-base font-bold text-slate-700">
                        Giá bán:
                    </span>

                    <span class="text-2xl sm:text-3xl font-extrabold text-red-600">
                        @Html.DisplayFor(a => Model.Product.Price)
                        @if (Model.Product.NgoaiTe != null)
                        {
                            <span class="ml-1 text-base sm:text-lg">
                                (@Model.Product.NgoaiTe)
                            </span>
                        }
                    </span>
                </div>

                <a href="@config.Facebook"
                   class="flex items-center justify-center gap-2 w-full rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-bold text-base py-3 shadow-md transition">
                    <i class="fa fa-shopping-cart"></i>
                    Mua Ngay
                </a>
            </div>


            <!-- Mua trả góp -->
            <div class="product-card-container bg-white/95 rounded-2xl shadow-lg p-5 sm:p-6 border border-slate-100">
                <div class="text-lg font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100">Ước tính trả góp</div>
                <div class="mb-4">
                    <label class="block text-slate-800 font-bold mb-2 text-sm">Giá Của Acc:</label>
                    <input type="text" value="@Html.DisplayFor(a => Model.Product.Price)" readonly class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-xl bg-slate-50 text-slate-900 font-bold text-sm focus:outline-none">
                </div>

                <div class="mb-2">
                    <label class="block text-slate-800 font-bold mb-2 text-sm">Trả Trước 30%:</label>
                    <input type="text" value="@discount.ToString("C0", culture)" readonly class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-xl bg-slate-100 text-red-600 font-extrabold text-base focus:outline-none">
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Raw(cdn)

@section scripts{
    <script>
        $('.slider-for').slick({
            slidesToShow: 1,
            slidesToScroll: 1,
            arrows: false,
            fade: false,
            asNavFor: '.slider-nav'
        });
        $('.slider-nav').slick({
            slidesToShow: 5,
            slidesToScroll: 1,
            asNavFor: '.slider-for',
            dots: false,
            centerMode: false,
            focusOnSelect: true
        });
        Fancybox.bind("[data-fancybox='product-gallery']", {
            Thumbs: {
                autoStart: true,
            },
            Toolbar: {
                display: ["close"],
            },
        });

    </script>
}