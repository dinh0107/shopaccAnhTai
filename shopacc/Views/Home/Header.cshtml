@using shopacc.Models
@{
    var config = (ConfigSite)HttpContext.Current.Application["ConfigSite"];
}

<header class="site-header shadow-md transition-colors duration-300">
    <div class="flex items-center justify-between px-4 lg:px-20 py-3">
        <div class="shrink-0 flex items-center gap-3">
            <a href="/" class="flex items-center gap-2">
                @if (config?.Image != null)
                {
                    <img src="@Path.Combine("/images/configs/", config.Image)" alt="Logo" class="h-10 sm:h-12 object-contain">
                }
                else
                {
                    <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-orange-500 to-amber-500 text-white font-black text-xl shadow-md">
                        AT
                    </div>
                }
            </a>
        </div>

        <nav class="hidden lg:flex flex-1 justify-center gap-8 text-lg font-medium">
            <a href="/" class="nav-link text-[14px] font-semibold transition">Trang Chủ</a>
            <a href="/" class="nav-link text-[14px] font-semibold transition">Acc Mới Nhất</a>
            <a href="@Url.Action("ProductList")" class="nav-link text-[14px] font-semibold transition">Acc cho thuê</a>
            <a href="@Url.Action("TinhGop")" class="nav-link text-[14px] font-semibold transition">Tính trả góp</a>
            <a href="@Url.Action("NapUc")" class="nav-link text-[14px] font-semibold transition">Nạp UC</a>
        </nav>

        <div class="hidden lg:flex shrink-0 items-center gap-2 text-right">
            <div>
                <div class="header-site-title font-extrabold text-base">@(config?.Title ?? "Shop Acc Anh Tài")</div>
                <div class="header-site-subtitle text-xs font-semibold">Shop bán acc uy tín</div>
            </div>
        </div>
        <button class="lg:hidden hamburger" id="menuToggle" onclick="show()">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</header>


<div class="overflow" onclick="Close()">
</div>

<div class="header-mobile p-0 overflow-hidden">
    <div class="row  p-2">
        <div class="col-5">
            <a href="/">
                @if (config.Image != null)
                {
                    <img src="@Path.Combine("/images/configs/", config.Image)" alt="@config.Title" class="logo logo-mb">
                }
            </a>
        </div>
        <div class="col-7 text-right text-white d-flex align-items-center justify-content-end pr-5">
            <div class="close-header" onclick="Close()"><i class="fas fa-times"></i></div>
        </div>
    </div>
    <ul class="ul-reset ul-mb mt-4">
        <li class="li-mb">
            <div class="p-2 mx-3">
                <a href="/">Trang chủ</a>
            </div>
        </li>
        <li class="li-mb">
            <div class="p-2 mx-3">
                <a href="/" class="text-[14px] hover:text-orange-500 transition">Acc Mới Nhất</a>
            </div>
        </li>
        <li class="li-mb">
            <div class="p-2 mx-3">
                <a href="@Url.Action("ProductList")" class="text-[14px] hover:text-orange-500 transition">Acc cho thuê</a>
            </div>
        </li>
        <li class="li-mb">
            <div class="p-2 mx-3">
                <a href="@Url.Action("TinhGop")" class="text-[14px] hover:text-orange-500 transition">Tính trả góp</a>
            </div>
        </li>
        <li class="li-mb">
            <div class="p-2 mx-3">
                <a href="@Url.Action("NapUc")" class="text-[14px] hover:text-orange-500 transition">Nạp UC</a>
            </div>
        </li>
    </ul>
</div>