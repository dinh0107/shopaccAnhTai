@model shopacc.ViewModel.NapUcViewModel
@using shopacc.Models
@using System.Globalization

@{
    var config = (ConfigSite)HttpContext.Current.Application["ConfigSite"];
    ViewBag.Title = "Nạp Uc";
    var culture = new CultureInfo("vi-VN");
}

<div class="breadcrumb-container px-4 sm:px-8 lg:px-20 py-3.5 mb-2">
    <nav class="flex items-center space-x-2 text-sm" aria-label="Breadcrumb">
        <a href="/" class="text-slate-600 hover:text-orange-500 font-medium">Trang chủ</a>
        <span class="text-slate-400">/</span>
        <strong class="text-slate-900 font-bold">Bảng Giá Nạp UC</strong>
    </nav>
</div>

<section class="px-4 sm:px-8 lg:px-20 pt-4 sm:pt-6 lg:pt-8">
    <div class="product-card-container bg-white/95 rounded-2xl sm:rounded-3xl shadow-xl p-4 sm:p-8 mb-6 border border-slate-100">
        <h2 class="section-title text-xl sm:text-2xl font-extrabold text-slate-900 mb-4 pb-2 border-b border-slate-200 flex items-center gap-2">
            <i class="fa-solid fa-bolt text-amber-500"></i>
            BẢNG GIÁ NẠP UC VNG
        </h2>
        <div class="overflow-x-auto">
            <table class="theme-table text-center">
                <thead>
                    <tr>
                        <th class="py-3 px-4 font-bold">Giá</th>
                        <th class="py-3 px-4 font-bold">Nạp Lần 1</th>
                        <th class="py-3 px-4 font-bold">Nạp Lần 2</th>
                        <th class="py-3 px-4 font-bold">Nạp Lần 3+</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Tables)
                    {
                        <tr class="hover:bg-amber-50/50 transition">
                            <td class="font-semibold text-slate-800 py-3 px-4">@item.Price</td>
                            <td class="text-emerald-700 font-bold py-3 px-4">@item.Lan1</td>
                            <td class="text-emerald-700 font-bold py-3 px-4">@item.Lan2</td>
                            <td class="text-emerald-700 font-bold py-3 px-4">@item.Lan3</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="product-card-container bg-white/95 rounded-2xl sm:rounded-3xl shadow-xl p-4 sm:p-8 mb-6 border border-slate-100">
        <h2 class="section-title text-xl sm:text-2xl font-extrabold text-slate-900 mb-4 pb-2 border-b border-slate-200 flex items-center gap-2">
            <i class="fa-solid fa-globe text-blue-500"></i>
            BẢNG GIÁ NẠP UC QUỐC TẾ
        </h2>
        <div class="overflow-x-auto">
            <table class="theme-table text-center">
                <thead>
                    <tr>
                        <th class="py-3 px-4 font-bold">Giá</th>
                        <th class="py-3 px-4 font-bold">UC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.TablesQT)
                    {
                        <tr class="hover:bg-blue-50/50 transition">
                            <td class="font-semibold text-slate-800 py-3 px-4">@item.Price</td>
                            <td class="text-blue-700 font-bold py-3 px-4">@item.Lan1</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>