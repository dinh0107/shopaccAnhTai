@model shopacc.ViewModel.TinhGopViewModel
@using shopacc.Models
@using System.Globalization

@{
    var config = (ConfigSite)HttpContext.Current.Application["ConfigSite"];
    ViewBag.Title = "Tính góp";
    var culture = new CultureInfo("vi-VN");
}

<div class="breadcrumb-container px-4 sm:px-8 lg:px-20 py-3.5 mb-2">
    <nav class="flex items-center space-x-2 text-sm" aria-label="Breadcrumb">
        <a href="/" class="text-slate-600 hover:text-orange-500 font-medium">Trang chủ</a>
        <span class="text-slate-400">/</span>
        <strong class="text-slate-900 font-bold">Tính góp</strong>
    </nav>
</div>
<section class="px-4 sm:px-8 lg:px-20 pt-4 sm:pt-6 lg:pt-8 max-w-3xl mx-auto">
    <div class="product-card-container bg-white/95 rounded-2xl sm:rounded-3xl shadow-xl p-6 sm:p-8 mb-6 border border-slate-100">
        <h1 class="section-title text-2xl sm:text-3xl font-extrabold text-slate-900 mb-2">Công cụ tính trả góp</h1>
        <p class="section-subtitle text-sm sm:text-base text-slate-600 font-medium mb-6">Ước tính số tiền cần thanh toán trả trước cho tài khoản game của bạn</p>
        
        <form action="@Url.Action("TinhGop")" method="post">
            <div class="mb-5">
                <label class="block text-slate-800 font-bold mb-2 text-sm">Giá Của Acc (VNĐ):</label>
                <input type="text" value="@Model.Gia.ToString("C0", culture)" name="gia" class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-xl bg-slate-50 text-slate-900 font-semibold focus:outline-none focus:border-orange-500">
            </div>

            <div class="mb-6">
                <label class="block text-slate-800 font-bold mb-2 text-sm">Trả Trước 30% (VNĐ):</label>
                <input type="text" value="@Model.GiaGop.ToString("C0", culture)" readonly class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-xl bg-slate-100 text-red-600 font-bold text-lg focus:outline-none">
            </div>

            <button type="submit" class="flex items-center justify-center gap-2 w-full rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-bold text-base py-3 shadow-md transition">
                <i class="fa-solid fa-calculator"></i>
                Tính ngay
            </button>
        </form>
    </div>
</section>