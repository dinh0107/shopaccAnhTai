@model shopacc.ViewModel.InfoAdminViewModel
@{
    ViewBag.Title = "Welcome to Admin";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="content">
    <div class="row mt-4">
            <div class="col-sm-12 col-md-6 col-lg-3 mt-md-5 mt-3">
                <div class="overview-item">
                    <div class="icon icon-combo"><i class="fa-light fa-briefcase-arrow-right"></i></div>
                    <a class="stretched-link" href="@Url.Action("ListTripChange", "Customer")">Tài khoán</a>
                    <p class="counter">@Model.Products</p>
                    <div class="info">
                        <i class="far fa-history me-1"></i> Cập nhật liên tục
                    </div>
                </div>
            </div>

    </div>
</div>
